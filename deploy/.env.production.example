# =============================================================================
# Lumos - Variables d'environnement de production
# Copier ce fichier vers .env à la racine du projet et remplir les valeurs
# =============================================================================

# Base de données (mot de passe fort, générer avec: openssl rand -base64 32)
DB_PASSWORD=

# Secret JWT (générer avec: openssl rand -base64 64)
JWT_SECRET=

# Clé API Anthropic (Claude) - nécessaire pour les fonctionnalités IA
ANTHROPIC_API_KEY=

# Port de l'application (3001 par défaut)
PORT=3001

# Domaine (laisser vide si pas encore de domaine)
# DOMAIN=lumos.example.com
